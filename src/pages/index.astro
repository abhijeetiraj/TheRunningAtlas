---
import Base from '../layouts/Base.astro';
import Grades from '../components/Grades.astro';
import { PATHS, LABS, ROADMAP, BASE, href } from '../data/site.js';
import { atlas } from '../lib/atlas.js';

const { sections, topics } = await atlas();
const openCount = topics.filter(t => t.state === 'open').length;

const ROUTE_MARKS = ['var(--accent)', 'var(--m-work)', 'var(--g-model)', 'var(--m-stretch)'];
const pad = n => String(n).padStart(2, '0');
---
<Base>
  <section class="hero-band">
    <div class="wrap hero">
      <div class="stage stage-hero" id="stage">
        <div class="hero-tags" aria-hidden="true"><span class="tele">Section 02 · The running stride</span><span class="tele">5:03 /km · 172 steps/min</span></div>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">{BASE.name} · Next to {BASE.gymName}</p>
        <h1 class="display">Every stride, <em>explained.</em></h1>
        <p class="lede">From your first run to the science underneath it: how to start, train, race and stay healthy, with 3D you can turn, slow down and explore.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={href('/how-running-works/stride/')}>Open the stride lab
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a class="btn btn-text" href={href('/strength-mobility-drills/warm-up/')}>Warm-up studio</a>
        </div>
        <p class="hero-note">Drag the runner to turn it. Every fact on the site shows how well it has been checked.</p>
      </div>
    </div>
  </section>

  <section class="wrap band">
    <div class="band-head"><h2 class="h2">Choose your route</h2><p class="sub">Four ways in, each through the sections that matter most for you.</p></div>
    <div class="routes">
      {PATHS.map((p, i) => (
        <div class="route" style={`--mark: ${ROUTE_MARKS[i]}`}>
          <div class="route-k label">Route {String.fromCharCode(65 + i)} · Sections {p.go.join(', ')}</div>
          <h3>{p.title}</h3>
          <p>{p.line}</p>
          <div class="route-go">
            {p.go.map(n => <a class="chip" href={href(`/${sections[n - 1].slug}/`)}>{pad(n)} · {sections[n - 1].title}</a>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap band" id="atlas">
    <div class="band-head"><h2 class="h2">The atlas</h2><p class="sub">Eleven sections and {topics.length} topics, from first steps to deep science. {openCount} topics are open in this preview; the rest are being written.</p></div>
    <div class="plates">
      {sections.map(s => {
        const shown = s.topics.slice(0, 5), more = s.topics.slice(5);
        const item = t => <li class:list={[`tp-${t.state}`]}>{t.href ? <a href={href(t.href)}>{t.title}</a> : t.title}</li>;
        return (
          <article class:list={['sec-plate', { 'is-live': s.open > 0 }]} id={`sec-${s.n}`}>
            <div class="sp-top">
              <span class="sp-no">Section {pad(s.n)}</span>
              <span class="sp-state">{s.open > 0 ? `${s.open} of ${s.topics.length} open` : 'Being written'}</span>
            </div>
            <div class="sp-body">
              <h3><span class="vh">Section {s.n}: </span><a href={href(`/${s.slug}/`)}>{s.title}</a></h3>
              <p class="sp-who">For {s.who.toLowerCase()}</p>
              <ul class="topics">{shown.map(item)}</ul>
              {more.length > 0 && (
                <details><summary>{more.length} more topic{more.length > 1 ? 's' : ''}</summary><ul class="topics">{more.map(item)}</ul></details>
              )}
            </div>
            <div class="sp-foot">
              <a class="live-link" href={href(`/${s.slug}/`)}>{s.open > 0 ? 'Open the section' : 'See what is coming'}</a>
            </div>
          </article>
        );
      })}
      <article class="finish">
        <p class="label">Finish line</p>
        <h3>How the atlas gets built</h3>
        <ol>{ROADMAP.map((r, i) => <li><span class="mono">{i}</span>{r}</li>)}</ol>
      </article>
    </div>
  </section>

  <section class="wrap band">
    <div class="band-head"><h2 class="h2">3D labs</h2><p class="sub">Ideas that are hard to see in words get a 3D lab. Every lab has a text version beside it.</p></div>
    <ol class="labs" id="labs">
      {LABS.map(l => (
        <li class:list={['lab', { 'is-live': l.href }]}>
          {l.href
            ? <a href={href(l.href)}><span class="lab-name">{l.name}</span><span class="lab-what">{l.what}</span><span class="lab-state">Open</span></a>
            : <div><span class="lab-name">{l.name}</span><span class="lab-what">{l.what}</span><span class="lab-state">Planned</span></div>}
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap band">
    <div class="band-head"><h2 class="h2">How every fact is graded</h2><p class="sub">Each claim links to its source in the evidence ledger.</p></div>
    <Grades />
    <p class="fine">Pages on injuries and health will be reviewed by a clinician before they go live. Any single red-flag symptom means seek care now.</p>
  </section>
</Base>

<script>
  import { initHome } from '../scripts/home.js';
  initHome();
</script>
