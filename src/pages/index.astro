---
import Base from '../layouts/Base.astro';
import Grades from '../components/Grades.astro';
import { PATHS, ROADMAP, BASE, PREVIEW, href } from '../data/site.js';
import { atlas, SHOW_DRAFTS } from '../lib/atlas.js';

const { sections, topics, labs } = await atlas();
const count = state => topics.filter(t => t.state === state).length;
const reviewCount = count('review'), comingCount = count('coming');
// Health pages no clinician has cleared are either published with a notice (SHOW_DRAFTS) or held back.
const readableCount = topics.filter(t => t.href).length;
const are = n => n === 1 ? 'is' : 'are';
// The intro's sentences after the open count: what has not been reviewed, and what is not written.
const notes = [
  reviewCount > 0 && (SHOW_DRAFTS
    ? `${reviewCount} of them ${are(reviewCount)} health pages that no clinician has reviewed yet, and each says so at the top.`
    : `${reviewCount} ${are(reviewCount)} written and waiting for a clinician’s review.`),
  comingCount > 0 && `${comingCount} ${are(comingCount)} still to come.`,
].filter(Boolean).join(' ');
/** A section's count line: the topics with a page, how many of its health pages are unreviewed, and what is to come. */
const tally = s => s.open === s.topics.length ? `All ${s.open} open` : [
  s.readable > 0 && `${s.readable} open`,
  s.review > 0 && (!SHOW_DRAFTS ? `${s.review} in review` : s.review === s.readable ? 'unreviewed' : `${s.review} unreviewed`),
  s.coming > 0 && `${s.coming} to come`,
].filter(Boolean).join(' · ');
const TOPIC_TAG = { review: SHOW_DRAFTS ? 'Unreviewed' : 'In review', coming: 'To come' };
/** How far a roadmap step has got, read from the state of its sections' topics. */
const progress = r => {
  const ts = r.sections.flatMap(n => sections[n - 1].topics);
  const n = state => ts.filter(t => t.state === state).length;
  const review = n('review'), coming = n('coming');
  const parts = [];
  if (ts.length === 0) parts.push('Done');
  else if (!ts.some(t => t.href) && coming === 0) parts.push('Written, in clinician review');
  else {
    if (ts.some(t => t.href)) parts.push('Open');
    if (review > 0) parts.push(SHOW_DRAFTS ? `${review} unreviewed` : `${review} in review`);
    if (coming > 0) parts.push(`${coming} to come`);
  }
  if (r.launch) parts.push(PREVIEW ? 'launch to come' : 'launched');
  return parts.join(' · ');
};

const ROUTE_MARKS = ['var(--accent)', 'var(--m-work)', 'var(--g-model)', 'var(--m-stretch)'];
const pad = n => String(n).padStart(2, '0');
---
<Base>
  <section class="hero-band">
    <div class="wrap hero">
      <div class="stage stage-hero" id="stage">
        <div class="hero-tags" aria-hidden="true"><span class="tele">Section 02 · The running stride</span><span class="tele">5:03 /km · 172 steps/min</span></div>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">{BASE.name} · Next to {BASE.gymName}</p>
        <h1 class="display">Every stride, <em>explained.</em></h1>
        <p class="lede">From your first run to the science underneath it: how to start, train, race and stay healthy, with 3D you can turn, slow down and explore.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={href('/how-running-works/stride/')}>Open the stride lab
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a class="btn btn-text" href={href('/strength-mobility-drills/warm-up/')}>Warm-up studio</a>
        </div>
        <p class="hero-note">Drag the runner to turn it. Every fact on the site shows how well it has been checked.</p>
      </div>
    </div>
  </section>

  <section class="wrap band">
    <div class="band-head"><h2 class="h2">Choose your route</h2><p class="sub">Four ways in, each through the sections that matter most for you.</p></div>
    <div class="routes">
      {PATHS.map((p, i) => (
        <div class="route" style={`--mark: ${ROUTE_MARKS[i]}`}>
          <div class="route-k label">Route {String.fromCharCode(65 + i)} · Sections {p.go.join(', ')}</div>
          <h3>{p.title}</h3>
          <p>{p.line}</p>
          <div class="route-go">
            {p.go.map(n => <a class="chip" href={href(`/${sections[n - 1].slug}/`)}>{pad(n)} · {sections[n - 1].title}</a>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap band" id="atlas">
    <div class="band-head"><h2 class="h2">The atlas</h2><p class="sub">Eleven sections and {topics.length} topics, from first steps to deep science. {readableCount} {are(readableCount)} open in this preview.{notes && ` ${notes}`}</p></div>
    <div class="plates">
      {sections.map(s => {
        const shown = s.topics.slice(0, 5), more = s.topics.slice(5);
        const tag = t => TOPIC_TAG[t.state] && <span class="tp-tag">{TOPIC_TAG[t.state]}</span>;
        const item = t => <li class:list={[`tp-${t.state}`, { 'tp-off': !t.href }]}>{t.href ? <a href={href(t.href)}><span class="tp-t">{t.title}</span>{tag(t)}</a> : <Fragment><span class="tp-t">{t.title}</span>{tag(t)}</Fragment>}</li>;
        return (
          <article class:list={['sec-plate', { 'is-live': s.readable > 0 }]} id={`sec-${s.n}`}>
            <div class="sp-top">
              <span class="sp-no">Section {pad(s.n)}</span><span class="vh">: </span>
              <span class="sp-state">{tally(s)}</span>
            </div>
            <div class="sp-body">
              <h3><span class="vh">Section {s.n}: </span><a href={href(`/${s.slug}/`)}>{s.title}</a></h3>
              <p class="sp-who">For {s.who.toLowerCase()}</p>
              <ul class="topics">{shown.map(item)}</ul>
              {more.length > 0 && (
                <details><summary>{more.length} more topic{more.length > 1 ? 's' : ''}</summary><ul class="topics">{more.map(item)}</ul></details>
              )}
            </div>
            <div class="sp-foot">
              <a class="live-link" href={href(`/${s.slug}/`)}>{s.readable > 0 ? 'Open the section' : s.review > 0 ? 'See what is in review' : 'See what is coming'}</a>
            </div>
          </article>
        );
      })}
      <article class="finish">
        <p class="label">Finish line</p>
        <h3>How the atlas gets built</h3>
        <ol>{ROADMAP.map((r, i) => <li><span class="mono">{i}</span><span>{r.step}<span class="vh">: </span><span class="rm-state">{progress(r)}</span></span></li>)}</ol>
      </article>
    </div>
  </section>

  <section class="wrap band">
    <div class="band-head"><h2 class="h2">3D labs</h2><p class="sub">Ideas that are hard to see in words get a 3D lab. Every lab has a text version beside it.</p></div>
    <ol class="labs" id="labs">
      {labs.map(l => (
        <li class:list={['lab', { 'is-live': l.href }]}>
          {l.href
            ? <a href={href(l.href)}><span class="lab-name">{l.name}</span><span class="lab-what">{l.what}</span><span class="lab-state">{l.review ? 'Open · not clinician reviewed' : 'Open'}</span></a>
            : <div><span class="lab-name">{l.name}</span><span class="lab-what">{l.what}</span><span class="lab-state">{l.review ? 'In clinician review' : 'Planned'}</span></div>}
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap band">
    <div class="band-head"><h2 class="h2">How every fact is graded</h2><p class="sub">Each claim links to its source in the evidence ledger.</p></div>
    <Grades />
    <p class="fine">{SHOW_DRAFTS && reviewCount > 0
      ? 'The health pages have not been reviewed by a clinician yet, and each one says so at the top. Any single red-flag symptom means seek care now.'
      : 'Pages on injuries and health will be reviewed by a clinician before they go live. Any single red-flag symptom means seek care now.'}</p>
  </section>
</Base>

<script>
  import { initHome } from '../scripts/home.js';
  initHome();
</script>
