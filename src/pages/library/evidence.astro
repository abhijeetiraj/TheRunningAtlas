---
import Base from '../../layouts/Base.astro';
import Ledger from '../../components/Ledger.astro';
import Grades from '../../components/Grades.astro';
import { CLAIMS, LEDGER_PAGES, claimsFor } from '../../data/claims.js';
import { href } from '../../data/site.js';

const counts = {};
for (const c of CLAIMS) counts[c.grade] = (counts[c.grade] || 0) + 1;
---
<Base title="Evidence ledger" description="Every claim on The Running Atlas, its source, and how well it has been checked.">
  <header class="page-head wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={href('/')}>Atlas</a><span aria-hidden="true">/</span><span>Plate 11 · Library</span><span aria-hidden="true">/</span><span aria-current="page">Evidence ledger</span></nav>
    <h1 class="display page-title">Evidence ledger</h1>
    <p class="lede">Every claim on the site, where it comes from, and how well it has been checked. A claim is only marked Checked once the exact passage has been read in the full source and recorded with its limits.</p>
    <p class="meta"><span>{CLAIMS.length} claims</span><span>{counts.checked || 0} checked</span><span>{counts.abstract || 0} abstract only</span><span>{counts.unchecked || 0} not yet checked</span><span>{counts.model || 0} model</span></p>
  </header>

  <section class="wrap band">
    <div class="band-head"><h2 class="h2">The four grades</h2></div>
    <Grades />
  </section>

  <section class="wrap band">
    {Object.entries(LEDGER_PAGES).map(([key, p]) => (
      <div class="ledger-group">
        <div class="band-head"><h2 class="h2"><a href={href(p.href)}>{p.title}</a></h2><p class="sub">{claimsFor(key).length} claims</p></div>
        <Ledger claims={claimsFor(key)} />
      </div>
    ))}
    <p class="fine">General information, not medical advice.</p>
  </section>
</Base>

<script>
  import { flashOnHash } from '../../scripts/ui.js';
  flashOnHash();
</script>
