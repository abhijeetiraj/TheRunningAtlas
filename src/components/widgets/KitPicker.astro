---
// What to wear: pick the temperature and conditions, get a kit list. Rules of thumb, not a standard.
---
<div class="widget kit" data-widget="kit">
  <h3 class="widget-h">What should I wear today?</h3>
  <p class="fine">Set the weather for your run. The list follows rules of thumb that many runners use.</p>
  <label class="w-field kit-t"><span>Temperature: <output data-out="t">10 °C · 50 °F</output></span>
    <input type="range" min="-15" max="35" step="1" value="10" data-in="t" />
  </label>
  <div class="toggles kit-opts" role="group" aria-label="Conditions">
    <label class="tog"><input type="checkbox" data-in="rain" /><span>Rain</span></label>
    <label class="tog"><input type="checkbox" data-in="wind" /><span>Wind</span></label>
    <label class="tog"><input type="checkbox" data-in="sun" /><span>Strong sun</span></label>
    <label class="tog"><input type="checkbox" data-in="dark" /><span>Dark</span></label>
    <label class="tog"><input type="checkbox" data-in="long" /><span>Longer than an hour</span></label>
  </div>
  <div class="kit-out" aria-live="polite">
    <p class="kit-rule" data-out="rule"></p>
    <ul data-out="list"></ul>
  </div>
</div>

<style>
  .kit-t { margin-top: 14px; }
  .kit-t input { width: 100%; }
  .kit-opts { margin-top: 12px; }
  .kit-out { margin-top: 14px; padding: 14px 16px; border-radius: 16px; border: 1px solid var(--line); background: var(--card); }
  .kit-out ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 6px; font-size: 16px; }
  .kit-out :global(li) { display: grid; grid-template-columns: 92px 1fr; gap: 10px; padding-top: 6px; border-top: 1px solid var(--line); }
  .kit-out :global(li b) { font: 500 10.5px/1.6 var(--f-mono); text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); font-weight: 500; }
  .kit-rule { margin: 0 !important; color: var(--ink-2); }
</style>

<script>
  for (const el of document.querySelectorAll('[data-widget="kit"]')) {
    const q = k => el.querySelector(`[data-in="${k}"]`);
    const tIn = q('t');
    const list = el.querySelector('[data-out="list"]'), rule = el.querySelector('[data-out="rule"]'), tOut = el.querySelector('[data-out="t"]');
    const f = c => Math.round(c * 9 / 5 + 32);
    const run = () => {
      const t = +tIn.value, rain = q('rain').checked, wind = q('wind').checked, sun = q('sun').checked, dark = q('dark').checked, long = q('long').checked;
      tOut.textContent = `${t} °C · ${f(t)} °F`;
      rule.textContent = `Dress for about ${t + 8} °C (${f(t + 8)} °F): once you are running you warm up fast, so feeling a little cold for the first few minutes is normal.`;
      const items = [];
      const add = (k, v) => items.push([k, v]);
      add('Feet', 'Running shoes that feel comfortable, and running socks (synthetic or wool) rather than cotton, which stays wet and can rub.');
      if (t >= 20) add('Top', 'A light, loose vest or T-shirt.');
      else if (t >= 12) add('Top', 'A T-shirt.');
      else if (t >= 5) add('Top', 'A long-sleeved top.');
      else if (t >= -5) add('Top', 'A long-sleeved base layer and a light jacket.');
      else add('Top', 'A warm base layer, a mid layer and a windproof jacket.');
      if (t >= 8) add('Legs', 'Shorts.');
      else if (t >= -5) add('Legs', 'Running tights, or shorts if you run warm.');
      else add('Legs', 'Thermal tights.');
      if (t < 8) add('Hands', t < -5 ? 'Warm gloves or mittens.' : 'Light gloves.');
      if (t < 3) add('Head', t < -5 ? 'A warm hat and a neck gaiter you can pull over your face.' : 'A hat or headband to keep your ears warm.');
      if (t < 0) add('Ground', 'Watch for ice. Pick cleared, gritted or lit routes, and slow down on corners.');
      if (rain) add('Rain', 'A light water-resistant jacket and a cap with a peak to keep rain out of your eyes. Anti-chafe balm where things rub.');
      if (wind) add('Wind', 'A windproof layer. Start into the wind, so it is behind you on the way home when you are tired and sweaty.');
      if (sun || t >= 24) add('Sun', 'A cap or visor, sunscreen and sunglasses. Run in the cooler hours if you can.');
      if (t >= 24) add('Heat', 'Slow down: heat makes the same pace harder. Carry water on longer runs.');
      if (dark) add('Be seen', 'Something bright with reflective strips, and a head torch or chest light where paths are unlit. Pick routes with lighting and people.');
      if (long) add('Longer runs', 'Anti-chafe balm, water or a route past it, and a snack for runs well over an hour.');
      add('Pocket', 'Your phone, a little money, and a note of who to call in an emergency.');
      list.innerHTML = items.map(([k, v]) => `<li><b>${k}</b><span>${v}</span></li>`).join('');
    };
    el.addEventListener('input', run); run();
  }
</script>
